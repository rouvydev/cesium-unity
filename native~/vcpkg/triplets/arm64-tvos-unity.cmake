include("${CMAKE_CURRENT_LIST_DIR}/shared/common.cmake")

set(VCPKG_TARGET_ARCHITECTURE arm64)
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_CMAKE_SYSTEM_NAME tvOS)
set(VCPKG_OSX_DEPLOYMENT_TARGET 15.0)

# sigaltstack is prohibited on tvOS, so doctest must not use POSIX signal handling.
set(VCPKG_C_FLAGS "${VCPKG_C_FLAGS} -DDOCTEST_CONFIG_NO_POSIX_SIGNALS")
set(VCPKG_CXX_FLAGS "${VCPKG_CXX_FLAGS} -DDOCTEST_CONFIG_NO_POSIX_SIGNALS")
